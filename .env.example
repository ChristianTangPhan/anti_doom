# Copy this to .env and fill it in. Never commit .env.

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
CATEGORY_NAME=Instagram

# Instagram (your main account)
IG_USERNAME=
IG_PASSWORD=

# Polling, in seconds (defaults are conservative for a main account)
ACTIVE_MIN=10
ACTIVE_MAX=15
IDLE_MIN=45
IDLE_MAX=75
ACTIVE_WINDOW=120
POLL_FLOOR=8
HOURLY_CAP=150
BACKOFF_SECONDS=900

# Safety limits
SENDS_PER_MINUTE=10
SCAN_COOLDOWN=30
MAX_LOGINS_PER_HOUR=3
MAX_BACKOFF_SECONDS=14400
